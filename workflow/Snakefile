rule occurrence_aggregated:
    output: "results/occurrence-{kind,[^/]+}/{params,[^/]+}-{runs}.csv"
    input: lambda wildcards: expand("results/occurrence-{{kind}}/run/{{params}}-{run}.csv", run=list(range(int(wildcards.runs))))
    run:
        df_data = pd.concat([pd.read_csv(file) for file in input])
        df_data.to_csv(output[0])

rule occurrence_aggregated_rw:
    output: "results/occurrence-rw/{kind,[^/]+}/{params,[^/]+}-{runs,[0-9]+}.csv"
    input: lambda wildcards: expand("results/occurrence-rw/{{kind}}/run/{{params}}-{run}.csv", run=list(range(int(wildcards.runs))))
    run:
        df_data = pd.concat([pd.read_csv(file) for file in input])
        df_data.to_csv(output[0])

