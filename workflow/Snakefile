COUNT_ESTIMATORS = ['HT-exact', 'HT-approx', 'OC-exact', 'OC-approx', 'IS-exact', 'IS-approx']
COUNT_GRAPHS = ['polbooks-1', 'contact-1', 'grid-10', 'er-100-0.1', 'delaunay-50', 'karate-0', 'football-0']

rule summarize_count_estimator_table:
    input:
        expand('results/count-estimator/{estimator}/{graph}.csv',
            estimator=COUNT_ESTIMATORS, graph=COUNT_GRAPHS)
    output:
        "results/count-estimator/summary.tex"
    params:
        estimators = COUNT_ESTIMATORS,
        graphs = COUNT_GRAPHS
    script:
        "scripts/summarize_count_estimator_table.py"


