from helper import coinsizes
import pandas as pd

# Figures that take comparatively little time to generate from scratch
rule quick:
    input:
        # Empirical Evaluation
        "figures/occurring_er_1000-0.1.pdf",
        "figures/prob_approx_er.pdf",
        "figures/prob_approx_er_sparse.pdf",

        # Application Example: Cycle Counting
        "results/count-estimator/summary.tex",

        # Application Example: Spin Glasses and Cycle Frustration
        "results/balance-estimator/summary.tex",

        # Appendix

        ## Accuracy
        "figures/prob_approx_er_mean_per_length.pdf",
        "figures/prob_approx_er_mean_per_length_sparse.pdf",
        ### Synthetic Examples
        expand("figures/prob_approx_{kind}.pdf", kind=['full_50', 'fullbip_100', 'sbm', 'sbm_heterophilic', 'barabasialbert', 'barbell', 'delaunay', 'grid']),
        ### Real-World Examples; most from Netzschleuder
        expand("figures/prob_approx_{kind}_rw.pdf", kind=['high_tech_company', 'new_guinea_tribes', 'november17', 'dutch_criticism', 'ceo_club', 'montreal', 'karate', 'game_thrones', 'florentine_families', 'student_cooperation']),

