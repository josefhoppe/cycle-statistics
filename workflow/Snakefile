rule time_exp:
    threads: 2
    priority: lambda wildcards, input: 1 if wildcards.method == 'Giscard-const' else 0
    input: "__cythonized__"
    output:
        "results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv"
    script:
        "scripts/time_exp.py"

