rule plot_time:
    output:
        "figures/time.pdf"
    input:
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-approx'], n=coinsizes(10,5000), p=[.5], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-approx'], n=coinsizes(50,10000), p=[.1], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-approx'], n=coinsizes(100,10000), p=[.05], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-approx'], n=coinsizes(20,5000), p=[.2], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['OC-exact'], n=coinsizes(10,500), p=[.5], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['OC-exact'], n=coinsizes(50,1000), p=[.1], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['OC-exact'], n=coinsizes(100,1000), p=[.05], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['OC-exact'], n=coinsizes(20,500), p=[.2], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-exact'], n=coinsizes(10,100), p=[.5], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-exact'], n=coinsizes(50,200), p=[.1], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-exact'], n=coinsizes(100,200), p=[.05], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['HT-exact'], n=coinsizes(20,200), p=[.2], N_factor=[1], samples=[100]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['Giscard-const'], n=coinsizes(10,100), p=[.5], N_factor=[1], samples=[10]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['Giscard-const'], n=coinsizes(50,200), p=[.1], N_factor=[1], samples=[10]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['Giscard-const'], n=coinsizes(100,200), p=[.05], N_factor=[1], samples=[10]),
        expand("results/time/{method}-{n}-{p}-{N_factor}-{samples}.csv", method=['Giscard-const'], n=coinsizes(20,200), p=[.2], N_factor=[1], samples=[10]),
    script:
        "scripts/plot_time.py"

rule plot_prob_approx_rw:
    input:
        # figure names use underscores, Netzschleuder names in results use dashes
        lambda wildcards: f"results/prob-approx/{wildcards.kind.replace('_', '-')}/0.csv"
    params:
        y_axis="approx",
        y_label="approx. incl. probability",
        x_label="correct inclusion probability",
        relative_inset='True'
    output:
        "figures/prob_approx_{kind,[a-zA-Z][a-zA-Z0-9\-\_]*}_rw.pdf"
    script:
        "scripts/plot_prob_approx.py"

synth_configs = [
    ('er', 'er/30-0.5'),
    ('er_sparse', 'er/30-0.15'),
    ('delaunay', 'delaunay/50'),
    ('barbell', 'barbell/23'),
    ('full_50', 'full/50'),
    ('fullbip_100', 'fullbip/100'),
    ('grid', 'grid/10'),
    ('sbm_heterophilic', 'sbm/50-0.2-0.4'),
    ('sbm', 'sbm/30-0.4-0.2'),
    ('barabasialbert', 'barabasialbert/30-0.25'),
]

for name, cfg in synth_configs:
    rule:
        name: f'plot_prob_approx_{name}'
        input:
            f"results/prob-approx/{cfg}.csv"
        params:
            y_axis="approx",
            y_label="approx. incl. probability",
            x_label="correct inclusion probability",
            relative_inset='True'
        output:
            f"figures/prob_approx_{name}.pdf"
        script:
            "scripts/plot_prob_approx.py"

