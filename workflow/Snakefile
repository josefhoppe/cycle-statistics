rw_datasets_small = ['karate*78', 'ceo-club', 'high-tech-company', 'student-cooperation', 'game-thrones', 'cs-department', 'polbooks', 'football', 'crime', 'facebook-friends', 'contact', 'sp-infectious', 'sp-high-school*proximity', 'wiki-science', 'sp-primary-school']

rw_datasets_medium = rw_datasets_small + ['dnc', 'chicago-road', 'escorts', 'sp-colocation*Thiers13', 'cofe', 'marvel-universe']

rw_datasets_all = rw_datasets_medium + ['email-enron', 'us-agencies*aggregate', 'dblp-coauthor-snap', 'roadnet*PA', 'roadnet*CA', 'hyves', 'wikitree', 'flixster', 'dblp-coauthor', 'as-skitter']

rule plot_time_rw:
    output: 'figures/time_rw.pdf'
    input: expand('results/time-rw/HT-approx/{kind}-100.csv', kind=rw_datasets_all),
           expand('results/time-rw/OC-exact/{kind}-100.csv', kind=rw_datasets_medium),
           expand('results/time-rw/IS-exact/{kind}-100.csv', kind=rw_datasets_medium),
           expand('results/time-rw/HT-exact/{kind}-100.csv', kind=rw_datasets_small),
           expand('results/time-rw/Giscard-const/{kind}-100.csv', kind=rw_datasets_small),
    script: 'scripts/plot_time_rw.py'

rule time_rw_tmp:
    input: 
           expand('results/time-rw/Giscard-const/{kind}-100.csv', kind=rw_datasets_small)

rule cythonize_spinglass:
    # Cythonizes the required files.
    input:
        "spinglass/solver.pyx"
    output:
        # actual output filename sytem-dependent and not relevant -> __cythonized__ used to mark dependencies and detect changes by snakemake.
        "__cythonized_spinglass__"
    shell:
        # remove option '-a' if you don't need to debug / profile
        "C_INCLUDE_PATH=$(python -c 'import numpy; print(numpy.get_include())') cythonize -i -a {input} && touch {output}"

rule cythonize:
    # Cythonizes the required files.
    input:
        "random_ccs/sampling.pyx",
        "random_ccs/spanning_trees.pyx"
    output:
        # actual output filename sytem-dependent and not relevant -> __cythonized__ used to mark dependencies and detect changes by snakemake.
        "__cythonized__"
    shell:
        # remove option '-a' if you don't need to debug / profile
        "C_INCLUDE_PATH=$(python -c 'import numpy; print(numpy.get_include())') cythonize -i -a {input} && touch {output}"

rule spinglass_exact:
    input:
        "__cythonized_spinglass__"
    output:
        "results/spinglass/{kind}/exact"
    script:
        "scripts/spinglass_exact.py"

